# Normalise line endings to LF in the repository, whatever the checkout OS.
* text=auto eol=lf

*.png  binary
*.jpg  binary
*.ico  binary
*.wav  binary
*.mp3  binary

# Machine-written: collapsed in GitHub's diff view, still diffable on demand.
frontend/package-lock.json        linguist-generated=true
backend/tests/contracts/*.json    linguist-generated=true
