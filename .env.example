# Copy to .env and edit. docker compose reads it automatically.

# ---- runtime -----------------------------------------------------------------
# auto | cuda | mps | cpu.  "auto" picks the best backend actually present.
DEVICE=auto

# Serialise generation on the GPU. Raise only if VRAM comfortably fits two models.
MAX_CONCURRENT_JOBS=1

# Unload an idle model after N seconds to free VRAM. 0 disables.
MODEL_IDLE_TIMEOUT=600

# Comma-separated provider ids, or "auto" for everything that imports cleanly.
PROVIDERS=auto

# Serve the tone-generating placeholder providers. Set 0 once real weights work.
DEV_STUB=1

LOG_LEVEL=INFO

# ---- ports -------------------------------------------------------------------
FRONTEND_PORT=8080
BACKEND_PORT=8000

# ---- credentials -------------------------------------------------------------
# Optional cloud fallback. Leave blank to run fully local; the provider is then
# not advertised by /v1/models at all.
ELEVENLABS_API_KEY=

# Required for gated HuggingFace repos (Stable Audio Open). Accept the licence
# on the model page first, then paste a read token here.
HF_TOKEN=
