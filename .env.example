# Copy to .env and edit. docker compose reads it automatically.
#
# The full stack runs on the Proxmox GPU box via compose.gpu.yml.
# docker-compose.yml is local dev only and needs almost none of this.

# ---- ports and exposure ------------------------------------------------------
FRONTEND_PORT=8080
BACKEND_PORT=8000

# Docker's published ports BYPASS ufw. Leave this on loopback and reach the box
# over Tailscale or an SSH tunnel; 0.0.0.0 exposes an unauthenticated GPU to
# the whole LAN.
BIND_ADDR=127.0.0.1

# Blank disables auth entirely. Set it before exposing the service anywhere,
# then enter the same value in the UI on the Server page: the browser sends it
# with every request. nginx deliberately does not add it for you -- a proxy that
# injects the key authenticates every anonymous caller along with you.
API_KEY=

# Host path for generated audio and voice references.
DATA_PATH=/srv/story/data

# ---- GPU box: toolchain ------------------------------------------------------
# Blackwell / RTX 50-series is sm_120 and needs CUDA >= 12.8 with a torch from
# the cu128 index or later. CUDA 12.4 / cu124 carry no sm_120 kernels and fail
# with "no kernel image is available for execution on the device".
#
# cu128 is pinned rather than something newer because all three model stacks
# declare exact +cu128 torch versions of their own.
CUDA_TAG=12.8.1-cudnn-runtime-ubuntu24.04
TORCH_INDEX=cu128

# ---- GPU box: runtime --------------------------------------------------------
# Generation is serialised on one semaphore per service. Leave at 1 unless you
# have measured that two models can generate concurrently in VRAM.
MAX_CONCURRENT_JOBS=1

# Unload an idle model to free VRAM. 1800s keeps a working session warm while
# still releasing the card overnight. 0 disables.
MODEL_IDLE_TIMEOUT=1800

LOG_LEVEL=INFO

# ---- credentials -------------------------------------------------------------
# Required for gated HuggingFace repos (Stable Audio 3). Accept the licence on
# the model page first. Read at runtime; never baked into an image.
HF_TOKEN=

# Optional cloud fallback. Blank means the provider is not advertised at all.
ELEVENLABS_API_KEY=

# ---- model selection ---------------------------------------------------------
# Stable Audio 3: blank uses the small checkpoints (120s). Flash Attention is
# NOT required -- the library falls back through a math-equivalent SDPA
# cascade. At 32 GB, medium is a straight upgrade: one checkpoint serves both
# music and sfx, with 380s max length.
#   SA3_MODEL=stabilityai/stable-audio-3-medium
SA3_MODEL=

# ACE-Step (music). ACESTEP_MODEL picks the DiT variant; blank means
# acestep-v15-base. Options include acestep-v15-turbo (fastest, max 8 steps),
# acestep-v15-sft, and the larger acestep-v15-xl-turbo / -xl-base / -xl-sft.
# The "ACE-Step/<name>" form is accepted too.
ACESTEP_MODEL=

# The optional planning LM: acestep-5Hz-lm-0.6B (blank default), -1.7B, -4B,
# or none to run the DiT alone.
ACESTEP_LM_MODEL=

# Runs that LM on 'pt' (plain PyTorch) or 'vllm'. vllm needs nano-vllm, which
# is not installed and is reported broken on sm_120.
ACESTEP_BACKEND=pt

# ---- frontend dev against the remote GPU box ---------------------------------
# The Vite dev server on your Mac proxies /api to this. Point it at the GPU VM:
#   VITE_API_TARGET=http://10.0.0.42:8000
VITE_API_TARGET=http://localhost:8000
