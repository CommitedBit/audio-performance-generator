# Copy to .env and edit. docker compose reads it automatically.

# ---- runtime -----------------------------------------------------------------
# auto | cuda | mps | cpu.  "auto" picks the best backend actually present.
DEVICE=auto

# Serialise generation on the GPU. Raise only if VRAM comfortably fits two models.
MAX_CONCURRENT_JOBS=1

# Unload an idle model after N seconds to free VRAM. 0 disables.
MODEL_IDLE_TIMEOUT=600

# Comma-separated provider ids, or "auto" for everything that imports cleanly.
PROVIDERS=auto

# Serve the tone-generating placeholder providers. Set 0 once real weights work.
DEV_STUB=1

LOG_LEVEL=INFO

# ---- ports -------------------------------------------------------------------
FRONTEND_PORT=8080
BACKEND_PORT=8000

# ---- credentials -------------------------------------------------------------
# Optional cloud fallback. Leave blank to run fully local; the provider is then
# not advertised by /v1/models at all.
ELEVENLABS_API_KEY=

# Required for gated HuggingFace repos (Stable Audio 3). Accept the licence on
# the model page first, then paste a read token here. Read at runtime only.
HF_TOKEN=

# ---- model selection ---------------------------------------------------------
# By default each track loads its own small Stable Audio 3 specialist (~2.4 GB
# peak each), which suits an 8 GB card. On 12 GB or more, pin the medium
# checkpoint here and ONE model serves both music and sfx:
#   SA3_MODEL=stabilityai/stable-audio-3-medium
# Medium REQUIRES flash-attn (EXTRAS includes `flash`) and compute capability
# >= 8.0. Without flash-attn its output silently collapses to static.
SA3_MODEL=

# ACE-Step is the music default (MIT weights). `pt` uses the PyTorch LM backend
# and avoids vLLM, whose pinned torch/CUDA kernels are the main packaging
# hazard. Switch to `vllm` only once the image is known good.
ACESTEP_MODEL=
ACESTEP_BACKEND=pt
